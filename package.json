{
  "name": "career-counselling",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "bun --filter admin dev",
    "build:admin": "bun --filter admin build",
    "dev:client": "bun --filter client dev",
    "build:client": "bun --filter client build",
    "dev:server": "bun --filter server dev",
    "start:server": "bun --filter server start",
    "seed": "bun --cwd apps/server run seed",
    "seed:assessment": "bun --cwd apps/server run seed:assessment"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "bson": "7.2.0",
    "tsx": "^4.23.12"
  }
}
